<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="loan_page" name="Loan page">
        <t t-call="website.layout">
            <h1 t-esc="loan.name"/>
            <!-- ODS101: unescaped user text -->
            <div class="note" t-raw="loan.note"/>
            <!-- ODS102: Markup() inside the template -->
            <p t-out="Markup(loan.partner_id.comment)"/>
        </t>
    </template>
    <template id="notice" name="Notice">
        <t t-call="website.layout">
            <div t-raw="message"/>
        </t>
    </template>
</odoo>
